<?xml version="1.0" encoding="utf-8"?>
<!-- Code shared by every Anstoss trainer (A2G, A3). Lives in its own repository and is embedded in
     each trainer repository as the git submodule Shared/. Compiled into each trainer's own exe, so each
     stays a single file. Game-specific additions live in the trainers as partial-class parts
     (e.g. Controller/ProcessMemory.A2.cs, Controller/Logger.A2.cs). -->
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <MSBuildAllProjects Condition="'$(MSBuildVersion)' == '' Or '$(MSBuildVersion)' &lt; '16.0'">$(MSBuildAllProjects);$(MSBuildThisFileFullPath)</MSBuildAllProjects>
    <HasSharedItems>true</HasSharedItems>
    <SharedGUID>6B1E4F0A-6C77-4C1C-9C2B-3A2E1F7C5D11</SharedGUID>
  </PropertyGroup>
  <PropertyGroup Label="Configuration">
    <Import_RootNamespace>AnstossTrainer.Shared</Import_RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)GameObserver.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Logger.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)ProcessMemory.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)TrainerShell.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Include="$(MSBuildThisFileDirectory)TrainerView.cs">
      <SubType>UserControl</SubType>
    </Compile>
    <Compile Include="$(MSBuildThisFileDirectory)ViewScaler.cs" />
  </ItemGroup>
</Project>
